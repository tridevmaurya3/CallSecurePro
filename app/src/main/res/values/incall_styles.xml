<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.CallSecurePro.InCall.Utility" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/csp_text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/csp_surface</item>
        <item name="strokeColor">@color/csp_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconTint">@color/csp_text_primary</item>
        <item name="iconPadding">6dp</item>
        <item name="rippleColor">@color/csp_ripple</item>
    </style>

    <style name="Widget.CallSecurePro.InCall.Answer" parent="Widget.Material3.Button">
