<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.CallSecurePro.DialKey" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">64dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/csp_text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/csp_surface</item>
        <item name="strokeColor">@color/csp_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">32dp</item>
        <item name="rippleColor">@color/csp_ripple</item>
    </style>

    <style name="Widget.CallSecurePro.DialCallButton" parent="Widget.Material3.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/csp_safe</item>
        <item name="cornerRadius">32dp</item>
        <item name="iconTint">@android:color/white</item>
        <item name="iconPadding">0dp</item>
        <item name="rippleColor">@color/csp_ripple</item>
    </style>

    <style name="Widget.CallSecurePro.DialUtilityButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/csp_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/csp_surface</item>
        <item name="strokeColor">@color/csp_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="iconTint">@color/csp_primary</item>
        <item name="rippleColor">@color/csp_ripple</item>
    </style>

</resources>
