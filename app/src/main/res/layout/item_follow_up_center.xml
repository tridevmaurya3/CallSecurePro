<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.CallSecurePro.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/csp_space_8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/csp_card_padding_compact">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/contactName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.CardTitle"
                    tools:text="Rahul Sharma" />

                <TextView
                    android:id="@+id/phoneNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_2"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Caption"
                    tools:text="+91 98765 43210" />
            </LinearLayout>

            <com.google.android.material.chip.Chip
                android:id="@+id/statusChip"
                style="@style/Widget.CallSecurePro.Chip.Unknown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/csp_space_8"
                tools:text="Overdue" />
        </LinearLayout>

        <TextView
            android:id="@+id/followUpTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_6"
            android:textAppearance="@style/TextAppearance.CallSecurePro.Label"
            tools:text="Follow-up: Today, 4:30 PM" />

        <TextView
            android:id="@+id/priorityText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_2"
            android:textAppearance="@style/TextAppearance.CallSecurePro.Caption"
            tools:text="Priority 80 • Overdue reminder • Missed call needs follow-up" />

        <TextView
            android:id="@+id/noteText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_6"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.CallSecurePro.Body"
            tools:text="Ask about the pending document tomorrow." />

        <TextView
            android:id="@+id/missingCallText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_4"
            android:text="@string/follow_up_center_call_missing"
            android:textAppearance="@style/TextAppearance.CallSecurePro.Caption"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/actionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_8"
            android:orientation="horizontal"
            android:weightSum="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detailButton"
                style="@style/Widget.CallSecurePro.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="44dp"
                android:text="@string/follow_up_center_open_detail"
                android:textSize="12sp" />

            <Space
                android:layout_width="@dimen/csp_space_4"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/snoozeButton"
                style="@style/Widget.CallSecurePro.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="44dp"
                android:text="@string/follow_up_center_snooze"
                android:textSize="11sp" />

            <Space
                android:layout_width="@dimen/csp_space_4"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/doneButton"
                style="@style/Widget.CallSecurePro.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="44dp"
                android:text="@string/follow_up_center_mark_done"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
