<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contactProfileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fluent_page"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ui.contacts.ContactProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/csp_page_horizontal"
        android:paddingTop="@dimen/csp_page_top"
        android:paddingEnd="@dimen/csp_page_horizontal"
        android:paddingBottom="@dimen/csp_page_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Widget.CallSecurePro.Button.Secondary"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/caller_setup_back"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text=""
                app:icon="@drawable/ic_back"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/csp_space_12"
                android:layout_weight="1"
                android:text="@string/contacts_profile_title"
                android:textAppearance="@style/TextAppearance.CallSecurePro.PageTitle" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/loadingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/csp_space_24" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_24"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.CallSecurePro.Body"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/profileContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_16"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CallSecurePro.Card.Mint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/csp_card_padding">

                    <TextView
                        android:id="@+id/contactInitial"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_contact_avatar"
                        android:gravity="center"
                        android:textColor="@color/csp_tertiary"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        tools:text="R" />

                    <TextView
                        android:id="@+id/contactName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_12"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.PageTitle"
                        tools:text="Rahul Sharma" />

                    <TextView
                        android:id="@+id/numberCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_4"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Caption"
                        tools:text="2 numbers" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/favoriteButton"
                        style="@style/Widget.CallSecurePro.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_10"
                        android:text="@string/contacts_profile_add_favorite"
                        app:icon="@drawable/ic_contact_favorite" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_space_12"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/callButton"
                    style="@style/Widget.CallSecurePro.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/contacts_profile_call" />

                <Space
                    android:layout_width="@dimen/csp_space_8"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/messageButton"
                    style="@style/Widget.CallSecurePro.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/contacts_profile_message" />

                <Space
                    android:layout_width="@dimen/csp_space_8"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lookupButton"
                    style="@style/Widget.CallSecurePro.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/contacts_profile_lookup" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_space_16"
                android:text="@string/contacts_profile_numbers"
                android:textAppearance="@style/TextAppearance.CallSecurePro.SectionTitle" />

            <LinearLayout
                android:id="@+id/numbersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_space_8"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
