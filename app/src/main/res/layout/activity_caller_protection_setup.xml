<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/setupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fluent_page"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".setup.CallerProtectionSetupActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/csp_page_horizontal"
        android:paddingTop="@dimen/csp_page_top"
        android:paddingEnd="@dimen/csp_page_horizontal"
        android:paddingBottom="@dimen/csp_page_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/backButton"
                android:layout_width="@dimen/csp_touch_target"
                android:layout_height="@dimen/csp_touch_target"
                android:background="@drawable/bg_icon_tile_blue"
                android:contentDescription="@string/setup_back"
                android:padding="12dp"
                android:src="@drawable/ic_back"
                app:tint="@color/csp_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/csp_space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_title"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.PageTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_2"
                    android:text="@string/setup_subtitle"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallSecurePro.Card.Header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/csp_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/csp_icon_tile_large"
                        android:layout_height="@dimen/csp_icon_tile_large"
                        android:contentDescription="@string/app_name"
                        android:src="@mipmap/ic_launcher" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/csp_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_header_title"
                            android:textAppearance="@style/TextAppearance.CallSecurePro.SectionTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/csp_space_4"
                            android:text="@string/setup_header_body"
                            android:textAppearance="@style/TextAppearance.CallSecurePro.Body" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/setupProgressText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_12"
                    android:text="@string/setup_progress_initial"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Label"
                    tools:text="0 of 3 setup items complete" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_section_gap"
            android:text="@string/setup_section_required"
            android:textAppearance="@style/TextAppearance.CallSecurePro.SectionTitle" />

        <!-- Caller ID and spam role -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallSecurePro.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_10">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/csp_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="@dimen/csp_icon_tile"
                        android:layout_height="@dimen/csp_icon_tile"
                        android:background="@drawable/bg_icon_tile_blue"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/csp_primary"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/csp_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_screening_title"
                            android:textAppearance="@style/TextAppearance.CallSecurePro.CardTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/csp_space_4"
                            android:text="@string/setup_screening_body"
                            android:textAppearance="@style/TextAppearance.CallSecurePro.Body" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:id="@+id/callerRoleStatusChip"
                    style="@style/Widget.CallSecurePro.Chip.Unknown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_12"
                    android:text="@string/setup_status_checking" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/callerRoleButton"
                    style="@style/Widget.CallSecurePro.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_8"
                    android:text="@string/setup_screening_action" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Contacts permission -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallSecurePro.Card.Mint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/csp_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="@dimen/csp_icon_tile"
                        android:layout_height="@dimen/csp_icon_tile"
                        android:background="@drawable/bg_icon_tile_blue"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/csp_tertiary"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/csp_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_contacts_title"
                            android:textAppearance="@style/TextAppearance.CallSecurePro.CardTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/csp_space_4"
                            android:text="@string/setup_contacts_body"
                            android:textAppearance="@style/TextAppearance.CallSecurePro.Body" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:id="@+id/contactsStatusChip"
                    style="@style/Widget.CallSecurePro.Chip.Unknown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_12"
                    android:text="@string/setup_status_checking" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/contactsPermissionButton"
                    style="@style/Widget.CallSecurePro.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_8"
                    android:text="@string/setup_contacts_action" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Call permission -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallSecurePro.Card.Lavender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/csp_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="@dimen/csp_icon_tile"
                        android:layout_height="@dimen/csp_icon_tile"
                        android:background="@drawable/bg_icon_tile_blue"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/csp_business"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/csp_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_call_title"
                            android:textAppearance="@style/TextAppearance.CallSecurePro.CardTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/csp_space_4"
                            android:text="@string/setup_call_body"
                            android:textAppearance="@style/TextAppearance.CallSecurePro.Body" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:id="@+id/callStatusChip"
                    style="@style/Widget.CallSecurePro.Chip.Unknown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_12"
                    android:text="@string/setup_status_checking" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/callPermissionButton"
                    style="@style/Widget.CallSecurePro.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_8"
                    android:text="@string/setup_call_action" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_section_gap"
            android:text="@string/setup_phone_integration_section"
            android:textAppearance="@style/TextAppearance.CallSecurePro.SectionTitle" />

        <!-- Default Phone integration status. Role request stays locked until full in-call UI exists. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallSecurePro.Card.Header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_10">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/csp_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_default_phone_title"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.CardTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_4"
                    android:text="@string/setup_default_phone_body"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Body" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/defaultPhoneStatusChip"
                    style="@style/Widget.CallSecurePro.Chip.Unknown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_12"
                    android:text="@string/setup_status_checking" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/defaultPhoneRoleButton"
                    style="@style/Widget.CallSecurePro.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_8"
                    android:enabled="false"
                    android:text="@string/setup_default_phone_action_locked" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallSecurePro.Card.Peach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_section_gap">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/csp_card_padding"
                android:text="@string/setup_privacy_note"
                android:textAppearance="@style/TextAppearance.CallSecurePro.Body" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/finishSetupButton"
            style="@style/Widget.CallSecurePro.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_16"
            android:text="@string/setup_finish" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
