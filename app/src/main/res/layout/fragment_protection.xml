<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fluent_page"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ui.protection.ProtectionFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/csp_page_horizontal"
        android:paddingTop="@dimen/csp_page_top"
        android:paddingEnd="@dimen/csp_page_horizontal"
        android:paddingBottom="@dimen/csp_page_bottom">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallSecurePro.Card.Peach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/csp_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/protection_real_title"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.PageTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_4"
                    android:text="@string/protection_real_subtitle"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Body" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.CallSecurePro.Chip.Verified"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_12"
                    android:text="@string/protection_status_active" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_6"
                    android:text="@string/protection_status_body"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_12"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CallSecurePro.Card.Peach"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/csp_space_10">

                    <TextView
                        android:id="@+id/blockedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Number" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/protection_stat_blocked"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="@dimen/csp_space_8"
                android:layout_height="1dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CallSecurePro.Card.Mint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/csp_space_10">

                    <TextView
                        android:id="@+id/trustedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Number" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/protection_stat_trusted"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="@dimen/csp_space_8"
                android:layout_height="1dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CallSecurePro.Card.Lavender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/csp_space_10">

                    <TextView
                        android:id="@+id/reportCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Number" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/protection_stat_reports"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallSecurePro.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/csp_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/protection_settings_title"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.SectionTitle" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/autoBlockSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_12"
                    android:text="@string/protection_auto_block_title"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.CardTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_2"
                    android:text="@string/protection_auto_block_body"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/silenceSuspiciousSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_16"
                    android:text="@string/protection_silence_title"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.CardTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_2"
                    android:text="@string/protection_silence_body"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/blockHiddenSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_16"
                    android:text="@string/protection_block_hidden_title"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.CardTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_2"
                    android:text="@string/protection_block_hidden_body"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/blockUnknownSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_16"
                    android:text="@string/protection_block_unknown_title"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.CardTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_2"
                    android:text="@string/protection_block_unknown_body"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/silenceUnknownSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_16"
                    android:text="@string/protection_silence_unknown_title"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.CardTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_2"
                    android:text="@string/protection_silence_unknown_body"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallSecurePro.Card.Mint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/csp_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/protection_history_title"
                            android:textAppearance="@style/TextAppearance.CallSecurePro.SectionTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/csp_space_2"
                            android:text="@string/protection_history_body"
                            android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clearScreeningHistoryButton"
                        style="@style/Widget.CallSecurePro.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/csp_space_8"
                        android:text="@string/protection_history_clear" />
                </LinearLayout>

                <TextView
                    android:id="@+id/screeningHistorySummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_8"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Label"
                    tools:text="2 blocked • 4 silenced • 8 allowed" />

                <TextView
                    android:id="@+id/screeningHistoryEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_10"
                    android:gravity="center"
                    android:padding="@dimen/csp_space_12"
                    android:text="@string/protection_history_empty"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />

                <LinearLayout
                    android:id="@+id/screeningHistoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallSecurePro.Card.Header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/csp_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/protection_analyze_title"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.SectionTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_4"
                    android:text="@string/protection_analyze_body"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Body" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/numberInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_12"
                    android:hint="@string/protection_number_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/numberInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="phone"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/analyzeButton"
                    style="@style/Widget.CallSecurePro.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_10"
                    android:text="@string/protection_analyze_action" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultCard"
            style="@style/Widget.CallSecurePro.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_12"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/csp_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/riskChip"
                        style="@style/Widget.CallSecurePro.Chip.Unknown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Suspicious" />

                    <TextView
                        android:id="@+id/riskScore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/csp_space_10"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Label"
                        tools:text="Risk score: 50/100" />
                </LinearLayout>

                <TextView
                    android:id="@+id/resultNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_10"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Number"
                    tools:text="+91 98765 43210" />

                <TextView
                    android:id="@+id/resultReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_4"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Body"
                    tools:text="Reported once as spam on this device" />

                <TextView
                    android:id="@+id/resultReports"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_4"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Caption"
                    tools:text="Local reports: 1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_12"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/trustButton"
                        style="@style/Widget.CallSecurePro.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/protection_trust" />

                    <Space
                        android:layout_width="@dimen/csp_space_8"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/blockButton"
                        style="@style/Widget.CallSecurePro.Button.Danger"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/protection_block" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reportButton"
                    style="@style/Widget.CallSecurePro.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_8"
                    android:text="@string/protection_report" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallSecurePro.Card.Peach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_16">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/csp_card_padding"
                android:text="@string/protection_privacy_note"
                android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
