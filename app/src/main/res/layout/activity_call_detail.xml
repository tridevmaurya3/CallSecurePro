<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/callDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fluent_page"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ui.calls.CallDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/csp_page_horizontal"
        android:paddingTop="@dimen/csp_page_top"
        android:paddingEnd="@dimen/csp_page_horizontal"
        android:paddingBottom="@dimen/csp_page_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/backButton"
                android:layout_width="@dimen/csp_touch_target"
                android:layout_height="@dimen/csp_touch_target"
                android:background="@drawable/bg_icon_tile_blue"
                android:contentDescription="@string/call_detail_back"
                android:padding="12dp"
                android:src="@drawable/ic_back"
                app:tint="@color/csp_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/csp_space_12"
                android:layout_weight="1"
                android:text="@string/call_detail_title"
                android:textAppearance="@style/TextAppearance.CallSecurePro.PageTitle" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/loadingIndicator"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/detailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CallSecurePro.Card.Header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/csp_card_padding">

                    <TextView
                        android:id="@+id/callerInitial"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_contact_avatar"
                        android:gravity="center"
                        android:text="#"
                        android:textColor="@color/csp_tertiary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="R" />

                    <TextView
                        android:id="@+id/callerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_12"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/call_detail_unknown"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.PageTitle"
                        tools:text="Rahul Sharma" />

                    <TextView
                        android:id="@+id/callerNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_4"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Body"
                        tools:text="+91 98765 43210" />

                    <TextView
                        android:id="@+id/callTypeAndTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_10"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Label"
                        tools:text="Incoming • Today, 8:17 AM" />

                    <TextView
                        android:id="@+id/callDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_4"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Caption"
                        tools:text="Duration: 2m 18s" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/riskChip"
                        style="@style/Widget.CallSecurePro.Chip.Unknown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_10"
                        tools:text="Safe • Risk 0/100" />

                    <TextView
                        android:id="@+id/riskReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_4"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Caption"
                        tools:text="Saved in your contacts" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_space_12"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/callButton"
                    style="@style/Widget.CallSecurePro.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/call_detail_call" />

                <Space
                    android:layout_width="@dimen/csp_space_8"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/messageButton"
                    style="@style/Widget.CallSecurePro.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/call_detail_message" />

                <Space
                    android:layout_width="@dimen/csp_space_8"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lookupButton"
                    style="@style/Widget.CallSecurePro.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/call_detail_lookup" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CallSecurePro.Card.Mint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/csp_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/call_detail_interaction_title"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.SectionTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_4"
                        android:text="@string/call_detail_interaction_subtitle"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_12"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/thirtyDayCallsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.CallSecurePro.Number" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/csp_space_2"
                                android:gravity="center"
                                android:text="@string/call_detail_30_day_calls"
                                android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/missedValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.CallSecurePro.Number" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/csp_space_2"
                                android:text="@string/call_detail_missed"
                                android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/talkTimeValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 min"
                                android:textAppearance="@style/TextAppearance.CallSecurePro.Number" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/csp_space_2"
                                android:text="@string/call_detail_talk_time"
                                android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CallSecurePro.Card.Lavender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/csp_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/call_detail_note_title"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.SectionTitle" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/noteInputLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_10"
                        android:hint="@string/call_detail_note_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/noteInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="1000"
                            android:maxLines="6"
                            android:minLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_16"
                        android:text="@string/call_detail_followup_title"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.CardTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_4"
                        android:text="@string/call_detail_followup_body"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/followUpChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_10"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/followUpNoneChip"
                            style="@style/Widget.CallSecurePro.Chip.Unknown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:checked="true"
                            android:text="@string/call_detail_followup_none" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/followUpTomorrowChip"
                            style="@style/Widget.CallSecurePro.Chip.Business"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/call_detail_followup_tomorrow" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/followUpThreeDaysChip"
                            style="@style/Widget.CallSecurePro.Chip.Business"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/call_detail_followup_3_days" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/followUpWeekChip"
                            style="@style/Widget.CallSecurePro.Chip.Business"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/call_detail_followup_1_week" />
                    </com.google.android.material.chip.ChipGroup>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/followUpStatusChip"
                        style="@style/Widget.CallSecurePro.Chip.Unknown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_10"
                        android:text="@string/call_detail_followup_none" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/markFollowUpDoneButton"
                        style="@style/Widget.CallSecurePro.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_8"
                        android:text="@string/call_detail_followup_done"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveButton"
                        style="@style/Widget.CallSecurePro.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_12"
                        android:text="@string/call_detail_save" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_20"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.CallSecurePro.Body"
            android:visibility="gone"
            tools:text="Call details unavailable"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
