<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ipRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fluent_page"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ui.network.IpIntelligenceActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/csp_page_horizontal"
        android:paddingTop="@dimen/csp_page_top"
        android:paddingEnd="@dimen/csp_page_horizontal"
        android:paddingBottom="@dimen/csp_page_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Widget.CallSecurePro.Button.Secondary"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/ip_lookup_back"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text=""
                app:icon="@drawable/ic_back"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/csp_space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ip_lookup_title"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.PageTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_2"
                    android:text="@string/ip_lookup_subtitle"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ipInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/ip_lookup_hint"
                app:boxBackgroundColor="@color/csp_surface"
                app:boxCornerRadiusBottomEnd="@dimen/csp_radius_medium"
                app:boxCornerRadiusBottomStart="@dimen/csp_radius_medium"
                app:boxCornerRadiusTopEnd="@dimen/csp_radius_medium"
                app:boxCornerRadiusTopStart="@dimen/csp_radius_medium"
                app:boxStrokeColor="@color/csp_outline"
                app:startIconDrawable="@drawable/ic_home_search"
                app:startIconTint="@color/csp_text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ipInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1"
                    android:minHeight="@dimen/csp_search_height" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/analyzeButton"
                style="@style/Widget.CallSecurePro.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/csp_search_height"
                android:layout_marginStart="@dimen/csp_space_8"
                android:text="@string/ip_lookup_analyze" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultCard"
            style="@style/Widget.CallSecurePro.Card.Header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_12"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/csp_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ip_lookup_local_title"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.SectionTitle" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/validityChip"
                        style="@style/Widget.CallSecurePro.Chip.Unknown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Valid IP" />
                </LinearLayout>

                <TextView
                    android:id="@+id/canonicalText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_10"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.CardTitle"
                    tools:text="Canonical: 192.168.1.10" />

                <TextView
                    android:id="@+id/versionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_6"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Body"
                    tools:text="Version: IPv4" />

                <TextView
                    android:id="@+id/scopeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_4"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Body"
                    tools:text="Scope: Private network" />

                <TextView
                    android:id="@+id/explanationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_8"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Caption"
                    tools:text="Private IPv4 address used on local networks." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallSecurePro.Card.Mint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/csp_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ip_device_network_title"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.SectionTitle" />

                <TextView
                    android:id="@+id/networkTransportText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_8"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Body"
                    tools:text="Active transport: Wi-Fi" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_8"
                    android:text="@string/ip_device_network_addresses_title"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Label" />

                <TextView
                    android:id="@+id/localAddressesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_4"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Caption"
                    tools:text="192.168.1.20\nfe80::1234" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallSecurePro.Card.Peach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_12">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/csp_card_padding"
                android:text="@string/ip_lookup_privacy_note"
                android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
