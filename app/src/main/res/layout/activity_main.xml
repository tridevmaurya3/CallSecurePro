<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fluent_page"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/designPreviewScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/csp_page_horizontal"
            android:paddingTop="@dimen/csp_page_top"
            android:paddingEnd="@dimen/csp_page_horizontal"
            android:paddingBottom="@dimen/csp_page_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/csp_icon_tile"
                    android:layout_height="@dimen/csp_icon_tile"
                    android:background="@drawable/bg_icon_tile_blue"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/csp_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/csp_space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/design_preview_title"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.PageTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_2"
                        android:text="@string/design_preview_subtitle"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CallSecurePro.Card.Header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_space_20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/csp_card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/design_ready"
                            android:textAppearance="@style/TextAppearance.CallSecurePro.SectionTitle" />

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.CallSecurePro.Chip.Verified"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/design_status_active" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/csp_space_8"
                        android:text="@string/design_ready_description"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_section_gap"
                android:text="@string/section_palette_title"
                android:textAppearance="@style/TextAppearance.CallSecurePro.SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_space_4"
                android:text="@string/section_palette_description"
                android:textAppearance="@style/TextAppearance.CallSecurePro.Body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_space_12"
                android:orientation="horizontal"
                android:weightSum="4">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.CallSecurePro.Card"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="@dimen/csp_space_6"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/csp_section_sky">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/palette_sky"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Label" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.CallSecurePro.Card.Lavender"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="@dimen/csp_space_6"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/palette_lavender"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Label" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.CallSecurePro.Card.Mint"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="@dimen/csp_space_6"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/palette_mint"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Label" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.CallSecurePro.Card.Peach"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/palette_peach"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Label" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_section_gap"
                android:text="@string/section_component_title"
                android:textAppearance="@style/TextAppearance.CallSecurePro.SectionTitle" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CallSecurePro.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_space_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/csp_card_padding">

                    <TextView
                        android:layout_width="@dimen/csp_avatar_medium"
                        android:layout_height="@dimen/csp_avatar_medium"
                        android:background="@drawable/bg_icon_tile_blue"
                        android:gravity="center"
                        android:text="RS"
                        android:textColor="@color/csp_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/csp_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sample_caller_name"
                            android:textAppearance="@style/TextAppearance.CallSecurePro.CardTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/csp_space_2"
                            android:text="@string/sample_caller_number"
                            android:textAppearance="@style/TextAppearance.CallSecurePro.Body" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/csp_space_2"
                            android:text="@string/sample_caller_detail"
                            android:textAppearance="@style/TextAppearance.CallSecurePro.Caption" />
                    </LinearLayout>

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.CallSecurePro.Chip.Safe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_safe" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_section_gap"
                android:text="@string/section_actions_title"
                android:textAppearance="@style/TextAppearance.CallSecurePro.SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_space_10"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.CallSecurePro.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/csp_space_8"
                    android:layout_weight="1"
                    android:text="@string/button_primary_preview" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.CallSecurePro.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/button_secondary_preview" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.CallSecurePro.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_space_8"
                android:text="@string/button_danger_preview" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_section_gap"
                android:text="@string/section_status_title"
                android:textAppearance="@style/TextAppearance.CallSecurePro.SectionTitle" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_space_10"
                app:chipSpacingHorizontal="@dimen/csp_space_8"
                app:chipSpacingVertical="@dimen/csp_space_8"
                app:singleLine="false">

                <com.google.android.material.chip.Chip
                    style="@style/Widget.CallSecurePro.Chip.Verified"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_verified" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.CallSecurePro.Chip.Safe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_safe" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.CallSecurePro.Chip.Business"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_business" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.CallSecurePro.Chip.Unknown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_unknown" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.CallSecurePro.Chip.Spam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_spam" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CallSecurePro.Card.Peach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/csp_section_gap">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/csp_card_padding"
                    android:text="@string/design_preview_note"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Body" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
