<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dialRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fluent_page"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp"
    tools:context=".ui.dial.DialFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dialNumberInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/dial_number_hint"
            app:boxBackgroundColor="@color/csp_surface"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeColor="@color/csp_outline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dialNumberInput"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:inputType="phone"
                android:maxLines="1"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.CallSecurePro.Number"
                android:textSize="22sp"
                tools:text="+91 98765 43210" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/moreOptionsButton"
            style="@style/Widget.CallSecurePro.DialUtilityButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/dial_more_options"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text=""
            app:icon="@drawable/ic_more_vertical"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp" />
    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key1"
            style="@style/Widget.CallSecurePro.DialKey"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:text="@string/dial_key_1" />

        <Space android:layout_width="28dp" android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key2"
            style="@style/Widget.CallSecurePro.DialKey"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:text="@string/dial_key_2" />

        <Space android:layout_width="28dp" android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key3"
            style="@style/Widget.CallSecurePro.DialKey"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:text="@string/dial_key_3" />
    </LinearLayout>

    <Space android:layout_width="1dp" android:layout_height="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key4"
            style="@style/Widget.CallSecurePro.DialKey"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:text="@string/dial_key_4" />

        <Space android:layout_width="28dp" android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key5"
            style="@style/Widget.CallSecurePro.DialKey"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:text="@string/dial_key_5" />

        <Space android:layout_width="28dp" android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key6"
            style="@style/Widget.CallSecurePro.DialKey"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:text="@string/dial_key_6" />
    </LinearLayout>

    <Space android:layout_width="1dp" android:layout_height="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key7"
            style="@style/Widget.CallSecurePro.DialKey"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:text="@string/dial_key_7" />

        <Space android:layout_width="28dp" android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key8"
            style="@style/Widget.CallSecurePro.DialKey"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:text="@string/dial_key_8" />

        <Space android:layout_width="28dp" android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key9"
            style="@style/Widget.CallSecurePro.DialKey"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:text="@string/dial_key_9" />
    </LinearLayout>

    <Space android:layout_width="1dp" android:layout_height="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyStar"
            style="@style/Widget.CallSecurePro.DialKey"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:text="@string/dial_key_star" />

        <Space android:layout_width="28dp" android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key0"
            style="@style/Widget.CallSecurePro.DialKey"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:text="@string/dial_key_0" />

        <Space android:layout_width="28dp" android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyHash"
            style="@style/Widget.CallSecurePro.DialKey"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:text="@string/dial_key_hash" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/callButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:contentDescription="@string/dial_call"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text=""
            app:icon="@drawable/ic_contact_call"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backspaceButton"
            style="@style/Widget.CallSecurePro.DialUtilityButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/dial_backspace"
            android:minWidth="54dp"
            android:padding="0dp"
            android:text=""
            app:icon="@drawable/ic_dial_backspace"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp" />
    </FrameLayout>

</LinearLayout>
