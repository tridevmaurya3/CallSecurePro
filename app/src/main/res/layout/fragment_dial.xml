<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fluent_page"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ui.dial.DialFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/csp_page_horizontal"
        android:paddingTop="@dimen/csp_page_top"
        android:paddingEnd="@dimen/csp_page_horizontal"
        android:paddingBottom="@dimen/csp_page_bottom">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallSecurePro.Card.Lavender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/csp_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dial_real_title"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.PageTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_4"
                    android:text="@string/dial_real_subtitle"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallSecurePro.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/csp_card_padding">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/dialNumberInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/dial_number_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/dialNumberInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:imeOptions="actionDone"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:textAlignment="center"
                        android:textAppearance="@style/TextAppearance.CallSecurePro.Number"
                        tools:text="+91 98765 43210" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/contactMatchCard"
                    style="@style/Widget.CallSecurePro.Card.Mint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_12"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/csp_card_padding_compact">

                        <TextView
                            android:id="@+id/contactMatchInitial"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_contact_avatar"
                            android:gravity="center"
                            android:text="R"
                            android:textColor="@color/csp_tertiary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/csp_space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/contactMatchName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.CallSecurePro.CardTitle"
                                tools:text="Rahul Sharma" />

                            <TextView
                                android:id="@+id/contactMatchNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/csp_space_2"
                                android:textAppearance="@style/TextAppearance.CallSecurePro.Caption"
                                tools:text="+91 98765 43210" />
                        </LinearLayout>

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.CallSecurePro.Chip.Safe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dial_contact_match_label" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/contactPermissionNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/csp_space_10"
                    android:text="@string/dial_contacts_permission_note"
                    android:textAppearance="@style/TextAppearance.CallSecurePro.Caption"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_16"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key1"
                style="@style/Widget.CallSecurePro.DialKey"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/dial_key_1" />

            <Space android:layout_width="@dimen/csp_space_10" android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key2"
                style="@style/Widget.CallSecurePro.DialKey"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/dial_key_2" />

            <Space android:layout_width="@dimen/csp_space_10" android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key3"
                style="@style/Widget.CallSecurePro.DialKey"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/dial_key_3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_10"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key4"
                style="@style/Widget.CallSecurePro.DialKey"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/dial_key_4" />

            <Space android:layout_width="@dimen/csp_space_10" android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key5"
                style="@style/Widget.CallSecurePro.DialKey"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/dial_key_5" />

            <Space android:layout_width="@dimen/csp_space_10" android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key6"
                style="@style/Widget.CallSecurePro.DialKey"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/dial_key_6" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_10"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key7"
                style="@style/Widget.CallSecurePro.DialKey"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/dial_key_7" />

            <Space android:layout_width="@dimen/csp_space_10" android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key8"
                style="@style/Widget.CallSecurePro.DialKey"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/dial_key_8" />

            <Space android:layout_width="@dimen/csp_space_10" android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key9"
                style="@style/Widget.CallSecurePro.DialKey"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/dial_key_9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_10"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/keyStar"
                style="@style/Widget.CallSecurePro.DialKey"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/dial_key_star" />

            <Space android:layout_width="@dimen/csp_space_10" android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key0"
                style="@style/Widget.CallSecurePro.DialKey"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/dial_key_0" />

            <Space android:layout_width="@dimen/csp_space_10" android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/keyHash"
                style="@style/Widget.CallSecurePro.DialKey"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/dial_key_hash" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/csp_space_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearButton"
                style="@style/Widget.CallSecurePro.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dial_clear" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/callButton"
                style="@style/Widget.CallSecurePro.DialCallButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/csp_space_12"
                android:layout_weight="1"
                android:text="@string/dial_call" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backspaceButton"
                style="@style/Widget.CallSecurePro.Button.Secondary"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="@dimen/csp_space_12"
                android:contentDescription="@string/dial_backspace"
                android:text="⌫"
                android:textSize="20sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
